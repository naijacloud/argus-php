<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="argus-php">
            <directory>tests</directory>
            <exclude>tests/contract</exclude>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <!-- The suite must never reach the network, or pick up a developer's
             real DSN from the shell. Anything that tries is a bug in the test. -->
        <env name="ARGUS_DSN" value="" force="true"/>
        <env name="SENTRY_DSN" value="" force="true"/>
        <env name="ARGUS_RELEASE" value="" force="true"/>
        <env name="SENTRY_RELEASE" value="" force="true"/>
        <env name="ARGUS_ENVIRONMENT" value="" force="true"/>
        <env name="SENTRY_ENVIRONMENT" value="" force="true"/>
        <env name="ARGUS_DEBUG" value="" force="true"/>
    </php>
</phpunit>
